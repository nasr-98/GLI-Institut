  </head>

  <body>
    <div class="container">

```
  <h1>New German Placement Test</h1>

  <div class="subtitle">
    A visitor has completed the
    <strong>„Teste dein Deutsch“</strong>
    placement test on the German Language Institut website.
  </div>

  <div class="status">
    ✓ Placement Test Completed
  </div>

  <div class="section-title">
    Tester Information
  </div>

  <div class="field">
    <div class="label">Full Name</div>
    <div class="value">
      <%= firstName + " " + lastName %>
    </div>
  </div>

  <div class="field">
    <div class="label">Email Address</div>
    <div class="value">
      <%= email %>
    </div>
  </div>

  <div class="field">
    <div class="label">Phone Number</div>
    <div class="value">
      <%= phone || "Not provided" %>
    </div>
  </div>

  <div class="section-title">
    Test Result
  </div>

  <div class="result-box">

    <div class="label">
      Estimated German Level
    </div>

    <div class="result-level">
      <%= finalLevel %>
    </div>

    <div class="result-description">
      <%= resultDescription %>
    </div>

  </div>

  <div class="field">
    <div class="label">Score</div>
    <div class="value">
      <%= totalCorrect %> / <%= totalAnswered %>
      (<%= scorePercentage %>%)
    </div>
  </div>

  <div class="field">
    <div class="label">Assessment Confidence</div>
    <div class="value">
      <%= confidence %>
    </div>
  </div>

  <div class="section-title">
    Results by Level
  </div>

  <table class="stats-table">
    <thead>
      <tr>
        <th>Level</th>
        <th>Answered</th>
        <th>Correct</th>
        <th>Status</th>
      </tr>
    </thead>

    <tbody>
      <% levels.forEach((level) => { %>

        <% const levelStatus = levelStatuses[level]; %>

        <tr>
          <td>
            <strong><%= level %></strong>
          </td>

          <td>
            <%= levelStatus.answered %>
          </td>

          <td>
            <%= levelStatus.correct %>
          </td>

          <td>
            <% if (levelStatus.status === "PASS") { %>
              <span class="status-pass">
                PASS
              </span>
            <% } else if (levelStatus.status === "FAIL") { %>
              <span class="status-fail">
                FAIL
              </span>
            <% } else if (levelStatus.status === "EXTRA") { %>
              <span class="status-extra">
                EXTRA
              </span>
            <% } else { %>
              <span class="status-continue">
                <%= levelStatus.status %>
              </span>
            <% } %>
          </td>
        </tr>

      <% }); %>
    </tbody>
  </table>

  <div class="section-title">
    Consent Information
  </div>

  <div class="consent">

    <div class="field">
      <div class="label">
        Privacy Policy
      </div>

      <div class="value">
        <%= privacyPolicy ? "Confirmed" : "Not confirmed" %>
      </div>
    </div>

    <div class="field" style="margin-bottom: 0;">
      <div class="label">
        Contact Consent
      </div>

      <div class="value">
        <%= contactConsent ? "Yes" : "No" %>
      </div>
    </div>

  </div>

  <div class="section-title">
    Test Information
  </div>

  <div class="field">
    <div class="label">
      Test ID
    </div>

    <div class="value">
      <%= attemptId %>
    </div>
  </div>

  <div class="field">
    <div class="label">
      Test Started
    </div>

    <div class="value">
      <%= startedAt || "Not available" %>
    </div>
  </div>

  <div class="field">
    <div class="label">
      Questions Answered
    </div>

    <div class="value">
      <%= totalAnswered %> / <%= maxQuestions %>
    </div>
  </div>

  <div class="footer">
    This is an automated notification from
    the German Language Institut website.

    <br /><br />

    The placement result is an internal assessment
    and does not constitute an official language certificate.
  </div>

</div>
```

