<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <title>Registration Confirmation</title>
  </head>

  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #f5f7fb;
      font-family: Arial, sans-serif;
    "
  >
    <div
      style="
        max-width: 650px;
        margin: 40px auto;
        background: #ffffff;
        padding: 35px;
        border-radius: 12px;
      "
    >
      <h1
        style="
          color: #1e3a8a;
          margin-top: 0;
        "
      >
        Registration Successful
      </h1>

      <p>
        Dear <%= firstName %> <%= lastName %>,
      </p>

      <p>
        Thank you for registering with the German Language Institut.
      </p>

      <p>
        We have successfully received your registration.
      </p>

      <hr />

      <h2>Registration Details</h2>

      <table
        style="
          width: 100%;
          border-collapse: collapse;
        "
      >
        

        <tr>
          <td
            style="
              padding: 10px;
              font-weight: bold;
            "
          >
            Course Level
          </td>

          <td style="padding: 10px;">
            <%= courseLevel %>
          </td>
        </tr>

        <tr>
          <td
            style="
              padding: 10px;
              font-weight: bold;
            "
          >
            Course Type
          </td>

          <td style="padding: 10px;">
            <%= courseType %>
          </td>
        </tr>

        <tr>
          <td
            style="
              padding: 10px;
              font-weight: bold;
            "
          >
            Preferred Start Date
          </td>

          <td style="padding: 10px;">
            <%= preferredStartDate %>
          </td>
        </tr>
      </table>

      <% if (addInfo) { %>
        <hr />

        <h2>Your Message</h2>

        <p
          style="
            background: #f7f7f7;
            padding: 15px;
            border-radius: 8px;
          "
        >
          <%= addInfo %>
        </p>
      <% } %>

      <hr />

      <p>
        Our team will contact you regarding the next steps.
      </p>

      <p>
        Best regards,<br />
        German Language Institute
      </p>
    </div>
  </body>
</html>